{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "incremental": true,
    "noUncheckedSideEffectImports": false,
    "libReplacement": true,
    "rootDir": ".",
    "plugins": [{ "name": "@tanstack/router-plugin" }],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@cloudflare/workers-types", "vite/client", "unplugin-icons/types/react"]
  },
  "include": ["src/**/*", "vite.config.ts", "*.ts", "*.tsx", "worker-configuration.d.ts"],
  "exclude": ["node_modules", ".output", ".vinxi", "dist"]
}
